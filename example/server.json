{
    "run_type": "server",
    "local_addr": "0.0.0.0",
    "local_port": 443,
    "remote_addr": "127.0.0.1",
    "remote_port": 80,
    "password": [
        "your_password"
    ],
    "ssl": {
        "cert": "your_cert.crt",
        "key": "your_key.key",
        "sni": "your-domain-name.com"
    },
    "router": {
        "enabled": true,
        "block": [
            "geoip:private"
        ],
        "geoip": "/usr/share/trojan-go/geoip.dat",
        "geosite": "/usr/share/trojan-go/geosite.dat"
    },
    "hysteria2": {
        "enabled": false,
        "port": 8443,
        "up_mbps": 100,
        "down_mbps": 500,
        "masquerade_url": "https://www.bilibili.com",
        "auth_api": "http://127.0.0.1:8080/admin/api/hysteria/auth"
    }
}