# Legacy compatibility unit only.
# New deployments must use the generated units:
#   admin-service.service
#   control-service.service
#   trojan-data-plane.service
#   gateway-service.service
# This file keeps the historical embedded `web` command available for manual
# compatibility testing; it is not installed by the service-oriented deployer.

[Unit]
Description=Trojan-Go Legacy Embedded Web Service (Compatibility Only)
After=network.target
Documentation=https://github.com/voidluo/trojan-go

[Service]
Type=simple
User=root
NoNewPrivileges=true
ExecStart=/usr/local/bin/trojan-go web -config /etc/trojan-go/server.yaml
Restart=on-failure
RestartSec=10s
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
